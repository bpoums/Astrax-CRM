{
  "$schema": "node_modules/wrangler/config-schema.json",

  // WHY THIS FILE EXISTS — two deploy footguns, both silent.
  //
  // 1. `name` was previously auto-generated by Nitro from the GIT REMOTE:
  //      generateWorkerName() -> remote.origin.url -> "owner/repo" -> slug
  //    so `bpoums/closerform` produced `bpoums-closerform`, the live site.
  //    Renaming the GitHub repo to `bpoums/Astrax-CRM` silently changed it to
  //    `bpoums-astrax-crm`, and `wrangler deploy` then reported SUCCESS while
  //    publishing to a brand-new worker — the live site never changed. Pinning
  //    the name here means the deploy target no longer depends on what the
  //    repo happens to be called.
  //
  //    Changing this value moves the app's address, which lives in THREE
  //    places (Supabase Site URL, Redirect URLs, and the invite-user SITE_URL
  //    secret). Change all four together or auth emails break silently.
  //
  // 2. `compatibility_date` was stamped with TODAY'S DATE on every build, and
  //    Cloudflare rejects a date it considers to be in the future — which bit
  //    when deploying late in the day (after ~7pm PKT) and forced every deploy
  //    to pass `--compatibility-date` by hand. Pinning it makes the build
  //    deterministic, so `npx wrangler deploy` is now correct on its own.
  //
  // Nitro reads this file (findNearestFile: wrangler.json/.jsonc/.toml) and
  // merges it over its defaults into .output/server/wrangler.json, which is
  // generated and must never be hand-edited. Do NOT add `main` or `assets`
  // here — Nitro overrides those and will warn that yours are ignored.

  "name": "bpoums-closerform",
  "compatibility_date": "2026-08-01"
}
